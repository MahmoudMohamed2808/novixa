# Novixa Aqar — production environment template (Railway).
#
# This is the Railway layout described in docs/AQAR_KEYS_AND_SERVICES_AR.md.
# It is NOT the config for the VPS demos (aqar-demo / aqar-demo2) — those use
# deploy/aqar-demo/app.env and deploy/aqar-demo2/app.env instead.
#
# Nothing here is a live secret. <REPLACE_WITH_...> placeholders are filled in
# Railway Variables (web service), never in Git. Storage credentials are
# Railway variable references (${{bucket.VAR}}), not copied values.
# Derived from .env.example so both templates stay in sync.

APP_NAME="Novixa Aqar"
APP_ENV=production
APP_DEBUG=false
# Generate with `php artisan key:generate --show` and set the output on Railway.
# Never commit the generated value.
APP_KEY=<REPLACE_WITH_GENERATED_APP_KEY>
# Bare origin, exact scheme + domain, NO trailing slash — Spatie MediaLibrary
# builds absolute /storage URLs from it and a mismatch breaks every photo.
APP_URL=https://web-production-68b34.up.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Railway's health check hits $PORT; without this the deploy fails after 300s.
# healthcheckPath = /up (Laravel built-in). Keep a single worker (1GB RAM limit).
PORT=8000

MULTITENANCY=false

# Railway MySQL service reference variables.
DB_CONNECTION=mysql
DB_HOST=${{mysql.RAILWAY_INTERNAL_HOST}}
DB_PORT=${{mysql.RAILWAY_INTERNAL_PORT}}
DB_DATABASE=${{mysql.MYSQL_DATABASE}}
DB_USERNAME=${{mysql.MYSQL_USER}}
DB_PASSWORD=${{mysql.MYSQL_PASSWORD}}

STRIPE_KEY=
STRIPE_SECRET=
# Empty in the demo: no real payments. Set only when Stripe webhooks must be
# verified and recorded in production.
STRIPE_WEBHOOK_SECRET=
# Contact-form notification inbox (falls back to MAIL_FROM_ADDRESS).
CONTACT_INBOX_EMAIL=<REPLACE_WITH_OWNER_EMAIL>

BROADCAST_DRIVER=log
# Zero-dependency by default. Reverb is installed but no server is running, so
# broadcasting stays on `log` and the REVERB_* / PUSHER_* keys below stay empty.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Intentionally sync: 10 of 12 notifiers implement ShouldQueue, but Octane's
# http mode runs no queue worker (only `octane` in supervisord). With any other
# value those notifications would sit in a queue and never be sent.
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend SMTP. Port 2587 (not 587): 587 is blocked from Railway containers and
# hangs until the socket times out instead of refusing the connection.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=2587
MAIL_USERNAME=resend
MAIL_PASSWORD=<REPLACE_WITH_RESEND_API_KEY>
MAIL_ENCRYPTION=tls
# After the aqar.novixa.dev domain is verified in Resend, change this to
# noreply@aqar.novixa.dev (DNS records are listed in the keys document).
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# Private S3-compatible bucket (Railway Buckets / Tigris).
# AWS_BUCKET is the switch: remove it and both `media` and `documents` fall back
# to the local disk — that is the instant rollback, nothing is deleted.
# These are Railway variable REFERENCES, not literal keys.
AWS_ACCESS_KEY_ID=${{aqar-media.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{aqar-media.SECRET_ACCESS_KEY}}
AWS_DEFAULT_REGION=${{aqar-media.REGION}}
AWS_BUCKET=${{aqar-media.BUCKET}}
AWS_ENDPOINT=${{aqar-media.ENDPOINT}}
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=media
# Bare origin ONLY — never append /media. Laravel's S3 adapter appends the disk
# root (`media`) itself; appending it here yields /media/media/... and 404s.
MEDIA_URL=https://web-production-68b34.up.railway.app

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

OCTANE_SERVER=roadrunner
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000

# Optional. No key = supported local generation in the visitor's language,
# which is what the demo runs on. Any OpenAI-compatible endpoint works via
# OPENAI_BASE_URI. Keep the timeout short: this runs inside a web request.
OPENAI_API_KEY=
OPENAI_BASE_URI=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20

# UK-market integrations carried over from upstream. Declared empty on purpose
# (config/services.php + ServiceConfigurationTest.php enforce this).
BACKGROUND_CHECK_API_KEY=
BACKGROUND_CHECK_API_URL=
CREDIT_REPORT_API_KEY=
CREDIT_REPORT_API_URL=
INSURANCE_API_KEY=
INSURANCE_ENDPOINT=
POSTCODES_API_KEY=
POSTCODES_ENDPOINT=
LOCRATING_API_KEY=
ALLAGENTS_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
QUICKBOOKS_API_KEY=
QUICKBOOKS_ENDPOINT=
ACCOUNTING_SYSTEM=

# WalkScore covers US/Canada only — permanently empty for the Yemeni market.
WALKSCORE_API_KEY=
WALKSCORE_BASE_URI=https://api.walkscore.com

# Placeholder base URI. With no key the service short-circuits and never calls
# it; keep the key empty or every property page blocks on a DNS timeout.
NEIGHBORHOOD_DATA_BASE_URI=https://api.example.com
NEIGHBORHOOD_DATA_API_KEY=
